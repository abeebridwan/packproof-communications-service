    "@livekit/agents-plugin-silero": "1.9.5",
    "@livekit/rtc-node": "1.2.1",
    "@packproof/shared-contracts": "workspace:*",
    "@packproof/speech": "workspace:*",
    "@packproof/verification-adapters": "workspace:*",
    "dotenv": "17.2.3",
    "livekit-server-sdk": "2.19.2",
    "openai": "6.49.0",
    "zod": "4.6.7"
  }
