# LiveKit Cloud project credentials: local worker and independent gateway only.
# Find these in your project dashboard. Cloud-hosted workers receive them automatically;
# do not add them to the worker secrets file.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Generated locally by pnpm env:local; share the same value with gateway and Cloud worker.
VOICE_CONTEXT_SECRET=
# Generated locally; gateway-only public-demo invitation signing secret.
VOICE_INVITE_SECRET=
VOICE_ALLOWED_ORIGINS=http://localhost:5173,https://packproof-p0.vercel.app
# Optional explicit PackProof server assertion trust: {"issuer":"...","audience":"packproof-voice-gateway","jwksUrl":"https://..."}
VOICE_SESSION_AUTH_CONFIG=
GATEWAY_STATE_PATH=.runtime/gateway.sqlite
PORT=8080
# Meta Model API dashboard -> API keys. One MODEL_API_KEY serves Spark and STT
# if that account has both model permissions. A supplied key does not approve spending.
# Paid Meta requests remain disabled unless separately approved.
MODEL_API_KEY=
META_LIVE_ENABLED=false
# SDK error details can contain tool arguments. Keep production SDK logs quiet;
# the app still emits opaque session states, usage counters and provider errors.
LOG_LEVEL=fatal
# Explicit local smoke-test allowance only; does not enable unattended workers.
META_TEST_BUDGET_USD=0
# Shared durable ledger for local tests and gateway-admitted live calls.
META_BUDGET_PATH=.runtime/gateway/meta-budget.sqlite
# Reachable HTTPS gateway origin for single-use worker budget admission.
VOICE_GATEWAY_PUBLIC_URL=
# Terminal 1 will supply the scoped developer credential, URL and canonical paths.
# Keep fixtures until then. PACKPROOF_API_TOKEN is not a Supabase service-role key.
PACKPROOF_MODE=fixtures
PACKPROOF_API_BASE_URL=
PACKPROOF_API_TOKEN=
# Optional partial JSON mapping of operation -> /versioned/path/{itemId}
PACKPROOF_ENDPOINT_PATHS=
# Protected OpenAI-compatible Kokoro URL, including /v1.
# pnpm env:local configures the existing local protected proxy for local tests.
# Cloud worker requires a reachable HTTPS hostname protected by this service token.
# That hostname comes from the independently approved Kokoro deployment.
KOKORO_BASE_URL=
KOKORO_SERVICE_TOKEN=
ALLOW_LOCAL_SERVICES=false
# Sonetel is unavailable; no telephone provider is active.
# Keep empty until a replacement provider and restricted SIP ingress are verified.
# These IDs and provider SIP credentials are separate from LiveKit API credentials.
LIVEKIT_ALLOWED_SIP_TRUNKS=
# For native LiveKit numbers: set the owned called number AND its assigned rule ID.
# These do not authenticate a PackProof account. Leave empty until configured.
LIVEKIT_ALLOWED_PHONE_NUMBERS=
LIVEKIT_ALLOWED_SIP_DISPATCH_RULES=
# Local passwords/control token are generated by pnpm env:local.
# Event URL/token will come from Terminal 1; keep RADIO_MODE=fixtures until then.
# Radio worker
RADIO_MODE=fixtures
RADIO_DATA_DIR=/data
RADIO_CONTROL_TOKEN=
RADIO_EVENT_SOURCE_URL=
RADIO_EVENT_SOURCE_TOKEN=
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
# Public build configuration only. The frontend reads these from the root .env.local.
# Set URLs to the actual gateway, stream and PackProof UI origins. Never put secrets in VITE_*.
VITE_VOICE_GATEWAY_URL=http://localhost:8080
VITE_RADIO_STREAM_URL=
VITE_PACKPROOF_ORIGIN=https://packproof-p0.vercel.app
