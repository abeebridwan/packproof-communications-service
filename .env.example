# Gateway and LiveKit worker. Configure only the services being run.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_CONTEXT_SECRET=
VOICE_INVITE_SECRET=
VOICE_ALLOWED_ORIGINS=http://localhost:5173,https://packproof-p0.vercel.app
# Optional explicit PackProof server assertion trust: {"issuer":"...","audience":"packproof-voice-gateway","jwksUrl":"https://..."}
VOICE_SESSION_AUTH_CONFIG=
GATEWAY_STATE_PATH=.runtime/gateway.sqlite
PORT=8080
# Paid Meta requests remain disabled unless separately approved.
MODEL_API_KEY=
META_LIVE_ENABLED=false
# Explicit fixtures or http; HTTP endpoint/DTO contract awaits Terminal 1.
PACKPROOF_MODE=fixtures
PACKPROOF_API_BASE_URL=
PACKPROOF_API_TOKEN=
# Optional partial JSON mapping of operation -> /versioned/path/{itemId}
PACKPROOF_ENDPOINT_PATHS=
# Protected OpenAI-compatible Kokoro URL, including /v1.
# Cloud worker requires a public HTTPS hostname protected by this service token.
KOKORO_BASE_URL=
KOKORO_SERVICE_TOKEN=
ALLOW_LOCAL_SERVICES=false
# Comma-separated approved LiveKit inbound trunk IDs; empty disables SIP.
LIVEKIT_ALLOWED_SIP_TRUNKS=
# Radio worker
RADIO_MODE=fixtures
RADIO_DATA_DIR=/data
RADIO_CONTROL_TOKEN=
RADIO_EVENT_SOURCE_URL=
RADIO_EVENT_SOURCE_TOKEN=
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
# Public build configuration only. Never put secrets in VITE_*.
VITE_VOICE_GATEWAY_URL=http://localhost:8080
VITE_RADIO_STREAM_URL=
VITE_PACKPROOF_ORIGIN=https://packproof-p0.vercel.app
