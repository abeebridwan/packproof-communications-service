{
  "name": "packproof-communications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "pnpm --filter @packproof/web-demo dev",
    "dev:gateway": "pnpm --filter @packproof/gateway dev",
    "dev:agent": "pnpm --filter @packproof/voice-agent dev",
    "start": "node apps/voice-agent/dist/main.js start",
    "radio:up": "docker compose --env-file .runtime/local.env -f apps/radio/compose.yaml up -d --build",
    "radio:down": "docker compose --env-file .runtime/local.env -f apps/radio/compose.yaml down",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.0"
    }
  }
}
